# Ignore synthetic data (all variations)
data/synthetic/
data/synthetic*/
data/benchmark_synth*/
data/synthetic_benchmark/

# Ignore all generated training data
data/generated/
data/phase*/

# Ignore current Phase 2 directories (legacy - use data/generated/ for future)
data/phase2_500classes/
data/phase2_random/
data/phase2_random_p*/

# Ignore all training runs except train12
runs/detect/train*/
!runs/detect/train12/

# Ignore all weights except best.pt and last.pt in train12
runs/detect/train12/weights/*
!runs/detect/train12/weights/best.pt
!runs/detect/train12/weights/last.pt

# Ignore all card images and backgrounds
data/images/

# Ignore YOLO model weights (download via scripts instead)
yolo*.pt
*.pt
!runs/detect/train12/weights/best.pt
!runs/detect/train12/weights/last.pt

# Ignore training logs and outputs
*.log
logs/
runs/train/

# Ignore large package builds (too big for GitHub)
packages/

# Ignore large ZIP files
*.zip

# Ignore benchmark files
benchmark_*.py
benchmark_*.txt
benchmark_*.log

# Ignore positioning cache
data/positioning_cache/

# Ignore archived code versions
scripts/computer_vision_application/archived/

# Ignore Python cache
__pycache__/
*.pyc
*.pyo

# Ignore uncompressed package directories (keep .tar.gz only)
packages/fab_card_detector_*/

.venv/

# Ignore explore_card_json.py utility script
scripts/explore_card_json.py

# Phase 3 reassembled weights (split parts are tracked)
models/Phase3/best.pt

# Ignore AWS credentials
scripts/aws/aws_credentials.txt

# Full training runs - keep metrics, ignore large files
runs/full_training/*/weights/
runs/full_training/*/train/
runs/full_training/*/val/
# Allow metrics and config files (CSV, PNG, YAML are small)
!runs/full_training/*/results.csv
!runs/full_training/*/results.png
!runs/full_training/*/args.yaml
!runs/full_training/*/*.png
!runs/full_training/*/*.csv
